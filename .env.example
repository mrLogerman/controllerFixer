# Required to email repair requests
RESEND_API_KEY=

# Required for /admin. Set this in the host environment, not in the repo.
ADMIN_PASSWORD=

# Optional. Signs the admin session cookie. Defaults to the admin password.
ADMIN_SESSION_SECRET=

# Sanity. The project id is public; the token stays on the server.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Optional. Your live domain, used for canonical links.
NEXT_PUBLIC_SITE_URL=

# Optional spam check. Both keys are required for it to run.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
